# Copy to .dev.vars for local wrangler (never commit .dev.vars)
AI_ENABLED=true
AI_ANON_DEMO_ENABLED=true
AI_MAX_RETRIES=2
# OPENAI_API_KEY=sk-...
OPENAI_MODEL_GENERATE=gpt-4.1-mini
OPENAI_MODEL_REWRITE=gpt-4.1-mini
# AI_DAILY_BUDGET=100

# Auth (Phase 06) — local redirects + magic-link debugging
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:4321
AUTH_COOKIE_SECURE=false
AUTH_DEV_LOG_LINKS=true
AUTH_DEV_RETURN_LINK=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stripe (Phase 09 — optional here)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
