---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PackLibrary from "../../../components/packs/PackLibrary";
---
<BaseLayout title="Activity packs — AI Crossword Maker" description="Classroom A/B/C layout packs." canonicalPath="/app/packs/" noindex={true}>
  <section class="container section" style="padding-top:1.5rem;">
    <nav class="muted" style="font-size:0.9rem;margin-bottom:0.75rem;">
      <a href="/app/">My puzzles</a> / Packs
    </nav>
    <h1>Activity packs</h1>
    <div class="acm-notice acm-notice--upsell" role="status" style="max-width:60ch;margin:0 0 1rem;">
      Same clues, different layouts (A/B/C) for classroom packets. Requires Activity Pack or Pro.
      Free plan can still print a single layout. <a href="/pricing/">View pricing</a>.
    </div>
    <PackLibrary client:load />
  </section>
</BaseLayout>
