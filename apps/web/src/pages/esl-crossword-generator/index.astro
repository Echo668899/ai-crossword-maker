---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MakerApp from "../../components/maker/MakerApp";
---

<BaseLayout
  title="ESL Crossword Generator — Vocabulary Practice"
  description="ESL crossword generator for vocabulary practice. Pick a topic and difficulty, edit clues, and print worksheets with answer keys."
  canonicalPath="/esl-crossword-generator/"
>
  <section class="container section" style="padding-top:1.5rem;">
    <nav class="muted" style="font-size:0.9rem;margin-bottom:0.75rem;"><a href="/">Home</a> / ESL</nav>
    <h1 style="margin:0 0 0.5rem;">ESL Crossword Generator</h1>
    <p style="max-width:60ch;margin:0 0 1rem;">
      Build level-friendly vocabulary crosswords. CEFR selectors deepen in v1.1 — for now choose Easy/Medium/Hard with Topic mode, or start from our
      <a href="/examples/esl-food-vocabulary/">ESL food</a> and <a href="/examples/esl-travel-phrases/">travel</a> examples.
    </p>
    <MakerApp client:load initialMode="topic" initialTopic="ESL food vocabulary for beginners" heading="ESL topic preset" />
  </section>
</BaseLayout>
