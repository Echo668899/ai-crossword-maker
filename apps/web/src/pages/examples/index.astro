---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  EXAMPLES,
  examplesBySubject,
  HIGH_TRAFFIC_EXAMPLE_SLUGS,
  LONG_TAIL_BATCH_2_SLUGS,
  LONG_TAIL_BATCH_3_SLUGS,
  LONG_TAIL_BATCH_4_SLUGS,
  LONG_TAIL_BATCH_5_SLUGS,
  LONG_TAIL_BATCH_6_SLUGS,
  LONG_TAIL_BATCH_7_SLUGS,
  LONG_TAIL_BATCH_8_SLUGS,
  LONG_TAIL_EXPANSION_SLUGS,
  getExample,
} from "../../lib/examples";

const featured = HIGH_TRAFFIC_EXAMPLE_SLUGS.map((slug) => getExample(slug)).filter(
  (ex): ex is NonNullable<typeof ex> => Boolean(ex),
);
const longTail = [
  ...LONG_TAIL_BATCH_8_SLUGS,
  ...LONG_TAIL_BATCH_7_SLUGS,
  ...LONG_TAIL_BATCH_6_SLUGS,
  ...LONG_TAIL_BATCH_5_SLUGS,
  ...LONG_TAIL_BATCH_4_SLUGS,
  ...LONG_TAIL_BATCH_3_SLUGS,
  ...LONG_TAIL_BATCH_2_SLUGS,
  ...LONG_TAIL_EXPANSION_SLUGS,
]
  .map((slug) => getExample(slug))
  .filter((ex): ex is NonNullable<typeof ex> => Boolean(ex));

const grouped = examplesBySubject();
const labels: Record<string, string> = {
  science: "Science",
  social: "Social studies",
  language: "Language arts",
  esl: "ESL",
  classroom: "Classroom",
  arts: "Arts",
};
const subjectJump = [...grouped.keys()].map((subject) => ({
  id: `subject-${subject}`,
  label: labels[subject] ?? subject,
}));
const site = import.meta.env.PUBLIC_SITE_URL || "https://aicrosswordmaker.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Crossword examples",
  numberOfItems: EXAMPLES.length,
  itemListElement: EXAMPLES.map((ex, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: `${ex.title} crossword`,
    url: new URL(`/examples/${ex.slug}/`, site).toString(),
  })),
};
---

<BaseLayout
  title="Crossword Examples — Free Printable Topic Puzzles"
  description={`Browse ${EXAMPLES.length} free printable crossword examples by topic. Each page includes a grid, clues, answer key, FAQ, and a make-a-variant CTA.`}
  canonicalPath="/examples/"
  jsonLd={jsonLd}
>
  <section class="container section" style="padding-top:1.5rem;">
    <nav class="muted" style="font-size:0.9rem;margin-bottom:0.75rem;"><a href="/">Home</a> / Examples</nav>
    <h1 style="margin:0 0 0.5rem;">Crossword examples</h1>
    <p style="max-width:62ch;margin:0 0 0.75rem;">
      {EXAMPLES.length} free printable topic puzzles for classroom inspiration. Each page has an interlocking grid, clues, answer key, and print button. Marked Sample until human-reviewed — not doorway stubs.
    </p>
    <p style="margin:0 0 0.75rem;">
      <a href="/ai-crossword-maker/">Make your own with AI</a>
      · <a href="/crossword-maker-for-teachers/">Teacher workflows</a>
      · <a href="/printable-crossword-maker/">Printable presets</a>
      · <a href="/esl-crossword-generator/">ESL generator</a>
      · <a href="/cefr-crossword/">CEFR crossword</a>
      · <a href="/blog/how-to-make-a-geography-vocabulary-crossword/">Geography how-to</a>
      · <a href="/blog/how-to-make-a-history-vocabulary-crossword/">History how-to</a>
      · <a href="/blog/how-to-make-a-social-studies-vocabulary-crossword/">Social studies how-to</a>
      · <a href="/blog/how-to-make-a-math-vocabulary-crossword/">Math how-to</a>
      · <a href="/blog/how-to-make-a-crossword-from-a-spelling-list/">Spelling-list how-to</a>
      · <a href="/blog/how-to-make-a-science-vocabulary-crossword/">Science how-to</a>
      · <a href="/blog/">How-to blog</a>
      · <a href="/pricing/">Pricing</a>
    </p>
    <p class="muted" style="margin:0 0 1.5rem;font-size:0.92rem;">
      Jump by subject:{" "}
      {
        subjectJump.map((s, i) => (
          <>
            {i > 0 ? " · " : null}
            <a href={`#${s.id}`}>{s.label}</a>
          </>
        ))
      }
    </p>
    <div style="margin-bottom:2rem;">
      <h2 class="section-title">Popular classroom topics</h2>
      <ul style="display:grid;gap:0.55rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));list-style:none;padding:0;margin:0.75rem 0 0;">
        {featured.map((ex) => (
          <li>
            <a
              href={`/examples/${ex.slug}/`}
              style="display:block;padding:0.85rem 1rem;border:1px solid var(--color-border);border-radius:8px;background:#fff;text-decoration:none;color:var(--color-ink);"
            >
              <strong>{ex.title}</strong>
              <div class="muted" style="font-size:0.85rem;margin-top:0.2rem;">
                {ex.reviewState === "human_reviewed" ? "Human-reviewed" : "Sample"} · {ex.gradeBand}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div style="margin-bottom:2rem;">
      <h2 class="section-title">New long-tail printables</h2>
      <ul style="display:grid;gap:0.55rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));list-style:none;padding:0;margin:0.75rem 0 0;">
        {longTail.map((ex) => (
          <li>
            <a
              href={`/examples/${ex.slug}/`}
              style="display:block;padding:0.85rem 1rem;border:1px solid var(--color-border);border-radius:8px;background:#fff;text-decoration:none;color:var(--color-ink);"
            >
              <strong>{ex.title}</strong>
              <div class="muted" style="font-size:0.85rem;margin-top:0.2rem;">
                Human-reviewed · {ex.gradeBand}
              </div>
              <div class="muted" style="font-size:0.9rem;margin-top:0.25rem;">{ex.blurb}</div>
            </a>
          </li>
        ))}
      </ul>
    </div>
    {
      [...grouped.entries()].map(([subject, list]) => (
        <div id={`subject-${subject}`} style="margin-bottom:2rem;">
          <h2 class="section-title">{labels[subject] ?? subject}</h2>
          <ul style="display:grid;gap:0.55rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));list-style:none;padding:0;margin:0.75rem 0 0;">
            {list.map((ex) => (
              <li>
                <a
                  href={`/examples/${ex.slug}/`}
                  style="display:block;padding:0.85rem 1rem;border:1px solid var(--color-border);border-radius:8px;background:#fff;text-decoration:none;color:var(--color-ink);"
                >
                  <strong>{ex.title}</strong>
                  <div class="muted" style="font-size:0.85rem;margin-top:0.2rem;">{ex.gradeBand} · Free printable</div>
                  <div class="muted" style="font-size:0.9rem;margin-top:0.25rem;">{ex.blurb}</div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
