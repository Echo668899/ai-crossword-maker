---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EXAMPLES, getExample, relatedExamples } from "../../lib/examples";
import { blogPostsForExample } from "../../lib/blog-posts";
import { buildExamplePuzzle } from "../../lib/build-example";

export function getStaticPaths() {
  return EXAMPLES.map((ex) => ({ params: { slug: ex.slug } }));
}

const slug = Astro.params.slug!;
const example = getExample(slug);
if (!example) {
  return Astro.redirect("/examples/");
}
const built = buildExamplePuzzle(example);
const related = relatedExamples(example.slug, 5);
const relatedGuides = blogPostsForExample(example.slug, 2);
const site = import.meta.env.PUBLIC_SITE_URL || "https://crosswordmaker.app";
const pageUrl = new URL(`/examples/${example.slug}/`, site).toString();
const reviewLabel = example.reviewState === "human_reviewed" ? "Human-reviewed" : "Sample";
const faq = [
  {
    q: `Is this ${example.title} crossword free to print?`,
    a: `Yes. This ${example.topic.toLowerCase()} crossword is free to print for classroom or home use. The page includes a blank grid, numbered clues, and a fold-away answer key. Content is marked ${reviewLabel}.`,
  },
  {
    q: "How do I print the puzzle and answer key?",
    a: "Use the Print puzzle button (or your browser Print). Hide the answer key details before printing student sheets; expand Answer key when you need the teacher copy. For editable PDFs with Name/Class/Period/Date presets, open the printable maker or teacher page.",
  },
  {
    q: "Can I make a different layout with the same topic?",
    a: `Use Make a variant with AI to open the Topic maker prefilled with “${example.topic}”, then edit clues and shuffle the layout before printing.`,
  },
  {
    q: "Are the answers fact-checked?",
    a: example.reviewState === "human_reviewed"
      ? "This page is marked Human-reviewed. Always spot-check clues for your class."
      : "This page is a Sample for inspiration — not a claim of curriculum certification or fact verification. Review clues before classroom use.",
  },
  {
    q: "Can students solve this online?",
    a: "This example page is a printable worksheet. After you create a variant in the maker, you can share a noindex play link so students solve in the browser without signing up.",
  },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", site).toString() },
      { "@type": "ListItem", position: 2, name: "Examples", item: new URL("/examples/", site).toString() },
      { "@type": "ListItem", position: 3, name: example.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<BaseLayout
  title={`${example.title} Crossword Puzzle (Free Printable)`}
  description={`${example.blurb} ${example.gradeBand}. Free printable ${example.topic.toLowerCase()} crossword with clues and answer key.`}
  canonicalPath={`/examples/${example.slug}/`}
  jsonLd={jsonLd}
>
  <section class="container section example-page" style="padding-top:1.5rem;">
    <nav class="muted no-print" style="font-size:0.9rem;margin-bottom:0.75rem;" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/examples/">Examples</a> / {example.title}
    </nav>
    <p class="no-print" style="margin:0 0 0.35rem;">
      <span style="display:inline-block;font-size:0.75rem;font-weight:700;padding:0.2rem 0.5rem;border-radius:4px;background:#E8EEF5;">
        {reviewLabel}
      </span>
      <span class="muted" style="margin-left:0.5rem;font-size:0.9rem;">{example.gradeBand}</span>
    </p>
    <h1 style="margin:0 0 0.5rem;">{example.title} Crossword Puzzle</h1>
    <p style="max-width:62ch;margin:0 0 1rem;">{example.blurb}</p>
    <p class="no-print example-actions" style="margin:0 0 1.25rem;display:flex;flex-wrap:wrap;gap:0.65rem;align-items:center;">
      <button type="button" class="print-btn" onclick="window.print()">Print puzzle</button>
      <a class="print-btn print-btn-secondary" href={`/ai-crossword-maker/?topic=${encodeURIComponent(example.topic)}`}>Make a variant with AI</a>
      <span class="muted" style="font-size:0.92rem;">
        <a href="/crossword-maker-for-teachers/">For teachers</a>
        · <a href="/printable-crossword-maker/">Printable maker</a>
        · <a href="/esl-crossword-generator/">ESL generator</a>
        · <a href="/pricing/">Pricing</a>
      </span>
    </p>

    <div class="grid-two example-print-body">
      <div>
        <h2 class="section-title">Puzzle grid</h2>
        <div class="example-grid-frame" set:html={built.svgBlank} />
        {!built.validationOk ? (
          <p class="muted no-print" style="font-size:0.9rem;">Note: this sample placed a subset of entries; regenerate locally for alternate seeds.</p>
        ) : null}
      </div>
      <div>
        <h2 class="section-title">Clues</h2>
        <h3 style="font-size:1rem;color:var(--color-primary);">Across</h3>
        <ol style="padding-left:1.1rem;">
          {built.across.map((c) => (
            <li value={c.number} style="margin-bottom:0.35rem;">
              {c.clue} <span class="muted">({c.length})</span>
            </li>
          ))}
        </ol>
        <h3 style="font-size:1rem;color:var(--color-primary);">Down</h3>
        <ol style="padding-left:1.1rem;">
          {built.down.map((c) => (
            <li value={c.number} style="margin-bottom:0.35rem;">
              {c.clue} <span class="muted">({c.length})</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <details class="example-answer-key" style="margin-top:2rem;border:1px solid var(--color-border);border-radius:8px;background:#fff;padding:0.85rem 1rem;">
      <summary style="font-weight:700;cursor:pointer;">Answer key</summary>
      <div set:html={built.svgAnswers} style="overflow:auto;margin-top:0.75rem;" />
      <p class="muted no-print" style="font-size:0.88rem;margin:0.75rem 0 0;">
        Tip: leave this section collapsed when printing student copies.
      </p>
    </details>

    <section class="no-print" style="margin-top:2.5rem;">
      <h2 class="section-title">FAQ</h2>
      {faq.map((item) => (
        <div style="margin-bottom:1rem;">
          <h3 style="font-size:1.05rem;margin:0 0 0.35rem;">{item.q}</h3>
          <p style="margin:0;max-width:65ch;">{item.a}</p>
        </div>
      ))}
    </section>

    <div class="no-print" style="margin-top:2rem;">
      <h2 class="section-title">Related examples</h2>
      <ul style="display:grid;gap:0.45rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));list-style:none;padding:0;margin:0.75rem 0 0;">
        {related.map((ex) => (
          <li>
            <a href={`/examples/${ex.slug}/`} style="text-decoration:none;color:var(--color-ink);">
              <strong>{ex.title}</strong>
              <div class="muted" style="font-size:0.88rem;">{ex.gradeBand}</div>
            </a>
          </li>
        ))}
      </ul>
      <h2 class="section-title" style="margin-top:1.75rem;">Related how-tos</h2>
      <ul style="display:grid;gap:0.45rem;list-style:none;padding:0;margin:0.75rem 0 0;">
        {relatedGuides.map((g) => (
          <li>
            <a href={`/blog/${g.slug}/`}>
              <strong>{g.title}</strong>
            </a>
            <div class="muted" style="font-size:0.88rem;">{g.description}</div>
          </li>
        ))}
      </ul>
      <p class="muted" style="margin-top:0.85rem;">
        Browse the full <a href="/examples/">examples index</a>. Need classroom A/B/C layouts?
        See <a href="/crossword-maker-for-teachers/">teacher packs</a>,
        <a href="/printable-crossword-maker/">printable name-line presets</a>,
        <a href="/esl-crossword-generator/">ESL generator</a>,
        <a href="/blog/">how-to blog</a>,
        and <a href="/pricing/">Pro pricing</a>.
      </p>
    </div>
  </section>
</BaseLayout>
