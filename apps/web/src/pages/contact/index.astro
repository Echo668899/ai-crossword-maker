  canonicalPath="/contact/"
>
  <section class="container section prose" style="padding-top:1.5rem;">
    <h1>Contact</h1>
    <p>
      Support email and business entity details are a <strong>publish blocker</strong> until the
      operator fills them in. Do not invent a legal entity.
    </p>
    <ul>
      <li><strong>Support email:</strong> [TO BE FILLED BEFORE LAUNCH]</li>
      <li><strong>Legal / privacy contact:</strong> [TO BE FILLED]</li>
      <li><strong>Operator entity:</strong> [TO BE FILLED]</li>
      <li><strong>Mailing address:</strong> [TO BE FILLED if required in your jurisdiction]</li>
    </ul>
    <p class="muted">
      Suggested mailbox once configured: <code>support@crosswordmaker.app</code> (not claimed as
      live until DNS/mailer is wired).
    </p>
  </section>
</BaseLayout>
