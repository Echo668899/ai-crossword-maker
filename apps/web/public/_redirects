# Pretty SSG shells. Destination is the pretty URL (/p/_/), never the
# on-disk index file — Workers HTML handling otherwise 308s and 404.html wins.
# Pages Advanced Mode public/_worker.js also rewrites these; keep 200 proxies
# as a fallback if the worker is absent.
/p/:token  /p/_/  200
/p/:token/  /p/_/  200
/app/packs/:id  /app/packs/_/  200
/app/packs/:id/  /app/packs/_/  200
/app/puzzles/:id/edit/  /app/puzzles/_/edit/  200
/app/puzzles/:id/edit  /app/puzzles/_/edit/  200
